<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.subtitles.legiekondor" name="Legie Kondor Subtitles" version="1.0.0" provider-name="Highflight Studio">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.requests" version="2.22.0"/>
    </requires>
    <extension point="xbmc.subtitle.module" library="service.py"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Legie Kondor (anime4.legiekondor.cz) subtitles for anime</summary>
        <description lang="en_GB">Searches and downloads Czech anime subtitles from Legie Kondor (anime4.legiekondor.cz). No account needed - the whole site is public. Matches Kodi's video metadata (or a manual search) against the site's small, hand-curated anime catalog.</description>
        <platform>all</platform>
        <license>All Rights Reserved</license>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
